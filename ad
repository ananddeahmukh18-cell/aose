from moviepy.editor import ImageClip, ColorClip, CompositeVideoClip, clips_array
import moviepy.video.fx.all as vfx

# 1. Load the Logo
logo_path = "aose_logo.png"  # Ensure your image is named this
main_logo = ImageClip(logo_path).set_duration(7)

# 2. Create the "Cut" Effect
# We split the logo into two halves: Left and Right
w, h = main_logo.size
left_half = main_logo.crop(x1=0, y1=0, x2=w/2, y2=h)
right_half = main_logo.crop(x1=w/2, y1=0, x2=w, y2=h)

# 3. Animate the Scissor Cut (0s to 3s)
# Note: You would need a 'scissors.png' icon for this part
# This moves the two halves apart after the "cut"
left_animated = left_half.set_position(lambda t: ((-10*t if t < 3 else -30), 'center'))
right_animated = right_half.set_position(lambda t: ((w/2 + 10*t if t < 3 else w/2 + 30), 'center'))

# 4. Animate the Stitch (3s to 7s)
# We move the pieces back together and overlay "thread" (thin lines)
left_final = left_animated.set_position(lambda t: ((-30 + 15*(t-3) if t > 3 else -30), 'center'))
right_final = right_animated.set_position(lambda t: ((w/2 + 30 - 15*(t-3) if t > 3 else w/2 + 30), 'center'))

# 5. Composite and Export
# You can add a background color matching your image (e.g., #E5D3B3)
bg = ColorClip(size=(w+100, h+100), color=(229, 211, 179)).set_duration(7)

final_video = CompositeVideoClip([bg, left_final, right_final])
final_video.write_videofile("aose_intro.mp4", fps=24)
